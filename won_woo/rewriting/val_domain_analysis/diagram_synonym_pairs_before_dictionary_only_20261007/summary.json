  "method": {
    "scope": "Rebuild lemmas, coverage and all candidates from observed valid source tokens, preserving original queries",
    "schema": "13 reference pair columns + 7 WordNet columns + 4 region/provenance columns + 8 context-review columns",
    "candidate_columns": [
      "source_lemma",
      "has_wordnet_entry",
      "wordnet_candidate_count",
      "wordnet_candidates",
      "other_split_candidate_count",
